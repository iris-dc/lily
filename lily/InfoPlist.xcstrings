{
  "sourceLanguage": "en",
  "strings": {
    "CFBundleDisplayName": {
      "comment": "Bundle display name",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "iskra"
          }
        }
      }
    },
    "CFBundleName": {
      "comment": "Bundle name",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "lily"
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "comment": "Privacy - Camera Usage Description",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iskra uses the camera to take photos for your chats."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iskra usa la cámara para hacer fotos para tus chats."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iskra utilise l’appareil photo pour prendre des photos pour vos discussions."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "iskra używa aparatu, aby robić zdjęcia do Twoich czatów."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A iskra usa a câmera para tirar fotos para as suas conversas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "iskra использует камеру, чтобы снимать фото для ваших чатов."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "iskra використовує камеру, щоб робити фото для ваших чатів."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription": {
      "comment": "Privacy - Location When In Use Usage Description",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iskra shows events near you and how far away they are."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iskra muestra eventos cerca de ti y a qué distancia están."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iskra affiche les événements près de vous et leur distance."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "iskra pokazuje wydarzenia w pobliżu i ich odległość od Ciebie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A iskra mostra eventos perto de si e a que distância ficam."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "iskra показывает события рядом с вами и расстояние до них."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "iskra показує події поруч із вами та відстань до них."
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription": {
      "comment": "Privacy - Photo Library Additions Usage Description",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iskra saves the pictures you pick from a chat to your photo library."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iskra guarda las fotos que eliges de un chat en tu fototeca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iskra enregistre dans votre photothèque les photos que vous choisissez dans une discussion."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "iskra zapisuje zdjęcia wybrane z czatu w Twojej bibliotece zdjęć."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A iskra guarda as fotos que escolhe numa conversa na sua biblioteca de fotos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "iskra сохраняет выбранные в чате фото в вашу медиатеку."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "iskra зберігає вибрані в чаті фото у вашу медіатеку."
          }
        }
      }
    }
  },
  "version": "1.0"
}
