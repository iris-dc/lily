    "The chat disappears for you. If %@ writes again, it comes back without the old messages.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чат исчезнет только у вас. Если %@ напишет снова, он вернётся, но уже без старых сообщений."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El chat desaparece para ti. Si %@ vuelve a escribir, regresa sin los mensajes antiguos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La discussion disparaît pour vous. Si %@ écrit de nouveau, elle revient sans les anciens messages."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Чат зникне у вас. Якщо %@ напише знову, він повернеться без старих повідомлень."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czat zniknie u Ciebie. Jeśli %@ napisze ponownie, wróci bez starych wiadomości."
