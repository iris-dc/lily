    "New events show up here as people create them.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Новые события появятся здесь, как только их кто-то создаст."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los nuevos eventos aparecerán aquí a medida que la gente los cree."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les nouveaux événements apparaissent ici au fil de leur création."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нові події з’являтимуться тут, щойно їх хтось створить."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nowe wydarzenia pojawią się tutaj, gdy ktoś je utworzy."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os novos eventos aparecem aqui à medida que são criados."
          }
        }
      }
    },
