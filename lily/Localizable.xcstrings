{
  "sourceLanguage": "en",
  "strings": {
    "%@ are in. Registration closes and the matches are drawn.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Участвуют: %@. Регистрация закроется, и матчи будут составлены."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ inscritos. Se cierra la inscripción y se sortean los partidos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ inscrits. Les inscriptions ferment et les matchs sont tirés."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Беруть участь: %@. Реєстрація закриється, і матчі буде складено."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W grze: %@. Rejestracja się zamknie, a mecze zostaną rozlosowane."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ confirmados. As inscrições fecham e as partidas são sorteadas."
          }
        }
      }
    },
