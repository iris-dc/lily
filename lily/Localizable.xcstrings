    "Price, what to expect, who you're looking for — all optional.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Цена, чего ожидать, кого вы ищете — всё по желанию."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Precio, qué esperar, a quién buscas: todo opcional."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le prix, à quoi s’attendre, qui vous cherchez — tout est facultatif."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ціна, чого очікувати, кого ви шукаєте — усе необов’язково."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cena, czego się spodziewać, kogo szukasz — wszystko opcjonalne."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Preço, o que esperar, quem procura — tudo opcional."
          }
        }
      }
    },
