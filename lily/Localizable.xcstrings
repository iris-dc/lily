    "You can be in at most %lld groups. Leave one to join another.": {
      "localizations": {
        "ru": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Можно состоять не более чем в %lld группе. Покиньте одну, чтобы вступить в другую."
                }
              },
              "few": {
                "stringUnit": {
