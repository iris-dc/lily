    "Sign in to see your chats, invites and event reminders.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Войдите, чтобы видеть свои чаты, приглашения и напоминания о событиях."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sesión para ver tus chats, invitaciones y recordatorios de eventos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous pour voir vos discussions, invitations et rappels d’événements."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увійдіть, щоб бачити свої чати, запрошення та нагадування про події."
