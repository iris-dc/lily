    "More teams or players need to enter before it can start.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы начать, нужно больше команд или игроков."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deben inscribirse más equipos o jugadores antes de empezar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il faut plus d'équipes ou de joueurs inscrits avant de commencer."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб почати, потрібно більше команд або гравців."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przed rozpoczęciem musi zgłosić się więcej drużyn lub graczy."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mais equipes ou jogadores precisam se inscrever antes de começar."
          }
        }
      }
    },
    "Move the map until the pin sits on the spot.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Двигайте карту, пока метка не окажется на нужном месте."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mueve el mapa hasta que el marcador quede sobre el lugar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déplacez la carte jusqu’à ce que l’épingle soit sur le lieu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Рухайте карту, доки позначка не опиниться на потрібному місці."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przesuwaj mapę, aż pinezka znajdzie się na miejscu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mova o mapa até o marcador ficar sobre o local."
          }
        }
      }
    },
