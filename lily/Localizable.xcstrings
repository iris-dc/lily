          }
        }
      }
    },
    "Sign in to see your groups and the events you join or host.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Войдите, чтобы видеть свои группы и события, в которых вы участвуете или которые организуете."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sesión para ver tus grupos y los eventos a los que te unes u organizas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous pour voir vos groupes et les événements que vous rejoignez ou organisez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увійдіть, щоб бачити свої групи та події, у яких ви берете участь або які організовуєте."
          }
        },
        "pl": {
