    "Sign in to create events, join them and chat with players.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Войдите, чтобы создавать события, присоединяться к ним и общаться с игроками."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sesión para crear eventos, unirte a ellos y chatear con los jugadores."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous pour créer des événements, les rejoindre et discuter avec les joueurs."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увійдіть, щоб створювати події, приєднуватися до них і спілкуватися з гравцями."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaloguj się, aby tworzyć wydarzenia, dołączać do nich i czatować z graczami."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Entre para criar eventos, participar neles e conversar com os jogadores."
          }
        }
      }
    },
    "Sign in to create events, join and chat.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Войдите, чтобы создавать события, присоединяться к ним и общаться."
          }
        },
        "es": {
          "stringUnit": {
