    "Filter by sport, distance and time. Tap Join and you're in, chat included.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Фильтруй по виду спорта, расстоянию и времени. Нажми «Присоединиться» — и ты в игре, чат уже открыт."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Filtra por deporte, distancia y hora. Toca Unirse y ya estás dentro, chat incluido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Filtrez par sport, distance et horaire. Touchez Rejoindre et c’est fait, discussion incluse."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Фільтруй за видом спорту, відстанню та часом. Натисни «Приєднатися» — і ти в грі, чат уже відкрито."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Filtruj według sportu, odległości i czasu. Dotknij Dołącz i jesteś w grze, razem z czatem."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Filtre por desporto, distância e hora. Toque em Participar e está dentro, com chat incluído."
          }
        }
      }
    },
