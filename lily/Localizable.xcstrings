    "Questions and complaints: support@iskra.red. The service is operated by the app's developer, reachable at that address.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вопросы и жалобы: support@iskra.red. Сервисом управляет разработчик приложения, доступный по этому адресу."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Preguntas y reclamaciones: support@iskra.red. El servicio lo gestiona el desarrollador de la app, localizable en esa dirección."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Questions et réclamations : support@iskra.red. Le service est exploité par le développeur de l’app, joignable à cette adresse."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запитання та скарги: support@iskra.red. Сервісом керує розробник застосунку, доступний за цією адресою."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pytania i skargi: support@iskra.red. Usługę prowadzi deweloper aplikacji, dostępny pod tym adresem."
          }
